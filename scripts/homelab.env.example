# Homelab environment contract.
#
# Copy to /etc/homelab/homelab.env on the hypervisor host and lock it down:
#
#   install -d -m 0750 /etc/homelab
#   install -m 0600 scripts/homelab.env.example /etc/homelab/homelab.env
#
# Every script in scripts/ reads this file. Nothing here has a default in code:
# a missing required value causes a startup error naming the variable, rather
# than a silent fallback. Override the file location with HOMELAB_ENV_FILE.

# ---------------------------------------------------------------------------
# Service endpoints
# ---------------------------------------------------------------------------
# Adjust to your own container addresses.
JELLYFIN_URL=http://192.168.1.11:8096
RADARR_URL=http://192.168.1.14:7878
SONARR_URL=http://192.168.1.14:8989
PROWLARR_URL=http://192.168.1.14:9696
JELLYSEERR_URL=http://192.168.1.14:5055
DOWNLOADER_URL=http://192.168.1.14:8080

# ---------------------------------------------------------------------------
# Service API keys
# ---------------------------------------------------------------------------
# Jellyfin:   Dashboard -> Advanced -> API Keys -> "+"
# Radarr etc: Settings -> General -> Security -> API Key
# Jellyseerr: Settings -> General -> API Key
JELLYFIN_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
JELLYSEERR_API_KEY=

# Downloader WebUI credentials. Leave blank if you have enabled the
# "bypass authentication for clients on localhost / whitelisted subnets"
# option for the subnet these scripts run from.
DOWNLOADER_USERNAME=
DOWNLOADER_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Host mount point for the shared media library.
MEDIA_ROOT=/mnt/media
# Container IDs the watchdog stops and restarts when the mount drops.
WATCHDOG_CT_IDS=201 204
# Media server address the watchdog pings for a library rescan after recovery.
MEDIA_SERVER_IP=192.168.1.11

# ---------------------------------------------------------------------------
# Notifications (ntfy)
# ---------------------------------------------------------------------------
# Pick a long, unguessable topic name: ntfy.sh topics are public to anyone who
# knows the string. Treat the topic itself as a secret.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# JSON stream the bot subscribes to for real-time request alerts.
NTFY_STREAM_URL=https://ntfy.sh/<NTFY_TOPIC>/json

# ---------------------------------------------------------------------------
# Discord bridge
# ---------------------------------------------------------------------------
# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token.
# Treat as a password. Never commit it.
DISCORD_TOKEN=

# Enable Developer Mode in Discord (User Settings -> Advanced), then
# right-click each object and "Copy ID".
DISCORD_GUILD_ID=
DISCORD_REQUEST_CATEGORY_ID=
DISCORD_OPS_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# Optional. The user the bot @-mentions for operator attention. When unset the
# bot says "an administrator" instead of tagging anyone.
OPERATOR_USER_ID=

# Name shown in embed footers.
BOT_BRAND=Homelab

# ---------------------------------------------------------------------------
# SRE agent CLI
# ---------------------------------------------------------------------------
# Any non-interactive coding-agent CLI works. The bridge shells out to:
#   $AGENT_CLI_BIN $AGENT_CLI_ARGS "<prompt>"
# and appends a continuation flag for multi-turn sessions.
#
# Examples:
#   Claude Code:  AGENT_CLI_BIN=/usr/local/bin/claude
#                 AGENT_CLI_ARGS=--add-dir /opt/homelab --print
#   Gemini CLI:   AGENT_CLI_BIN=/usr/local/bin/gemini
#                 AGENT_CLI_ARGS=--prompt
AGENT_CLI_BIN=
AGENT_CLI_ARGS=
AGENT_CLI_CONTINUE_FLAG=--continue
# Repository clone the agent is grounded against.
WORKSPACE_DIR=/opt/homelab
# Hard cap on a single agent run, in seconds.
AGENT_TIMEOUT_SECONDS=240
