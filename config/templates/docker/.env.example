# Copy this file to `.env` next to `media-stack.compose.yml` before deploying.
# Every value below is a placeholder. Replace them for your own environment.

TZ=Etc/UTC
PUID=1000
PGID=1000

# Shared media root on the container host.
# The download client, Radarr and Sonarr must ALL mount this same path at /media.
# See docs/setup/05-media-stack.md for why this matters.
MEDIA_ROOT=/mnt/media

GLUETUN_CONFIG_DIR=/opt/appdata/gluetun
DOWNLOADER_CONFIG_DIR=/opt/appdata/downloader
RADARR_CONFIG_DIR=/opt/appdata/radarr
SONARR_CONFIG_DIR=/opt/appdata/sonarr
PROWLARR_CONFIG_DIR=/opt/appdata/prowlarr
JELLYSEERR_CONFIG_DIR=/opt/appdata/jellyseerr
BAZARR_CONFIG_DIR=/opt/appdata/bazarr

# VPN egress for the download client. See your provider's Gluetun documentation
# for the correct VPN_SERVICE_PROVIDER value and required credentials.
VPN_SERVICE_PROVIDER=<your-provider>
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=<your-wireguard-private-key>
# Set the interface CIDR from your provider profile if required.
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=<your-preferred-country>
FIREWALL=on
DOT=off

DOWNLOADER_WEBUI_PORT=8080
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
JELLYSEERR_PORT=5055
BAZARR_PORT=6767

# Self-hosted ntfy. NTFY_BASE_URL must be set whenever NTFY_UPSTREAM_BASE_URL is,
# or the container fails startup validation and crash-loops.
NTFY_PORT=80
NTFY_BASE_URL=http://192.168.1.14
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
